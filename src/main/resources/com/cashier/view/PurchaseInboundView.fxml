<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.controller.PurchaseInboundController"
      spacing="0"
      styleClass="purchase-inbound-view">

    <!-- 顶部工具栏 -->
    <VBox spacing="6" styleClass="toolbar">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="inboundButton" text="%purchase_inbound.execute" onAction="#handleInbound"
                    minWidth="130" disable="true" styleClass="success-button"/>
            <Button fx:id="viewDetailButton" text="%purchase_inbound.view_detail" onAction="#handleViewDetail"
                    minWidth="120" disable="true" styleClass="info-button"/>
            <Button fx:id="viewHistoryButton" text="%purchase_inbound.view_history" onAction="#handleViewHistory"
                    minWidth="130" styleClass="secondary-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="" styleClass="text-muted"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="%purchase_inbound.search_label"/>
            <TextField fx:id="searchField" promptText="%purchase_inbound.search_hint"
                       minWidth="260" HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
            <Button text="%purchase_inbound.search" onAction="#handleSearch"
                    minWidth="80" styleClass="secondary-button"/>
            <Button text="%purchase_inbound.refresh" onAction="#handleRefresh"
                    minWidth="80" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <!-- 可入库订单表格 -->
    <TableView fx:id="orderTable"
              VBox.vgrow="ALWAYS"
              styleClass="purchase-inbound-table">
        <columns>
            <TableColumn fx:id="orderNoColumn" text="%purchase_inbound.order_no" prefWidth="180" minWidth="150"/>
            <TableColumn fx:id="supplierColumn" text="%purchase_inbound.supplier" prefWidth="220" minWidth="160"/>
            <TableColumn fx:id="purchaseDateColumn" text="%purchase_inbound.purchase_date" prefWidth="140" minWidth="120"/>
            <TableColumn fx:id="totalAmountColumn" text="%purchase_inbound.total_amount" prefWidth="160" minWidth="140"/>
            <TableColumn fx:id="purchaserColumn" text="%purchase_inbound.purchaser" prefWidth="130" minWidth="110"/>
        </columns>
        <placeholder>
            <Label text="%purchase_inbound.no_data" styleClass="text-muted, text-lg"/>
        </placeholder>
    </TableView>

</VBox>
