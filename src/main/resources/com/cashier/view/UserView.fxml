<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.controller.UserController"
      spacing="0"
      styleClass="user-view">

    <!-- 顶部工具栏：操作与筛选分两行，避免英文环境拥挤 -->
    <VBox spacing="6" styleClass="toolbar">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="addButton" text="%user.add" onAction="#handleAddUser"
                    minWidth="100" styleClass="primary-button"/>
            <Button fx:id="editButton" text="%user.edit_button" onAction="#handleEditUser"
                    minWidth="80" styleClass="secondary-button"/>
            <Button fx:id="deleteButton" text="%user.delete_button" onAction="#handleDeleteUser"
                    minWidth="80" styleClass="danger-button"/>
            <Button fx:id="resetPasswordButton" text="%user.reset_password" onAction="#handleResetPassword"
                    minWidth="120" styleClass="warning-button"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="activateButton" text="%user.activate" onAction="#handleActivateUser"
                    minWidth="90" styleClass="success-button"/>
            <Button fx:id="deactivateButton" text="%user.deactivate" onAction="#handleDeactivateUser"
                    minWidth="90" styleClass="warning-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="" styleClass="text-muted"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="%user.role_label"/>
            <ComboBox fx:id="roleFilterComboBox" minWidth="130"/>
            <Label text="%user.status_label"/>
            <ComboBox fx:id="statusFilterComboBox" minWidth="120"/>
            <Separator orientation="VERTICAL"/>
            <Label text="%user.search_label"/>
            <TextField fx:id="searchField" promptText="%user.search_hint"
                       minWidth="220" HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
            <Button text="%common.search" onAction="#handleSearch"
                    minWidth="80" styleClass="secondary-button"/>
            <Button text="%common.clear" onAction="#handleClearSearch"
                    minWidth="80" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <!-- 用户列表表格 -->
    <TableView fx:id="userTable"
              VBox.vgrow="ALWAYS"
              styleClass="user-table">
        <columns>
            <TableColumn fx:id="usernameColumn" text="%user.username" prefWidth="120"/>
            <TableColumn fx:id="nameColumn" text="%user.real_name" prefWidth="120"/>
            <TableColumn fx:id="roleColumn" text="%user.role" prefWidth="100"/>
            <TableColumn fx:id="createTimeColumn" text="%user.create_time" prefWidth="160"/>
            <TableColumn fx:id="lastLoginColumn" text="%user.last_login" prefWidth="160"/>
            <TableColumn fx:id="statusColumn" text="%user.status" prefWidth="80"/>
        </columns>
        <placeholder>
            <Label text="%user.no_data" styleClass="text-muted, text-lg"/>
        </placeholder>
    </TableView>

</VBox>
