# 编译输出
*.class
out/
build/
target/
dist/

# IDE 配置
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 数据文件（敏感信息）
data/
*.txt

# 配置文件（敏感信息）
config/*.properties
config/*.config
docker/create-cashier-user.sql
.env

# Windows 批处理文件（跟踪这些文件）
# *.bat

# Claude/iFlow 配置
.iflow/
.claude/
.workbuddy/
# AGENTS.md 与 CLAUDE.md 都是跟踪的说明文档（2026-09 起入库）；不要重新忽略它们

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
*.backup
*.lock
temp/

# JaCoCo 覆盖率数据（正常落在 target/，兜底防止异常调用写到仓库根）
jacoco.exec

# 导出文件
exports/

# 备份文件
backup_*/
data_backup_*/
backups/sql/

# JAR 文件（如果使用包管理器则忽略）
*.jar

# Maven Shade 插件生成的文件
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup

# 字体文件
fonts/exports/

# Logo 图片（用户上传，不提交）
logos/*
!logos/README.md

# Claude/iFlow 配置文件（本地使用，不提交）
# CLAUDE.md    # 注释掉 - 项目需要此文件
# IFLOW.md     # 注释掉 - 项目需要此文件
.deepseek/
fonts/*.ttc
src/main/resources/fonts/*.otf
src/main/resources/fonts/*.ttf
# 例外：PDF 导出必须内置可嵌入的 TrueType 中文字体（见 src/main/resources/fonts/README.md）
!src/main/resources/fonts/NotoSansSC-Regular.ttf
# 例外：该字体的 OFL 许可证必须随字体一起分发（全局 `*.txt` 规则会忽略它）
!src/main/resources/fonts/OFL-NotoSansSC.txt
